# ---------------------------------------------------------------------------
# Personal Networking CRM — environment variables
# Copy this file to `.env` for local dev. On Railway, set these as service
# variables (Settings → Variables). None of these are committed.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# SQLite by default. On Railway, mount a volume (e.g. at /data) and point here
# so your data survives redeploys:  file:/data/crm.db
DATABASE_URL="file:./prisma/dev.db"

# --- App auth -------------------------------------------------------------
# The single password you type on the login page. Pick something strong.
APP_PASSWORD="change-me-to-a-long-passphrase"
# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="change-me-32-plus-random-bytes"

# --- Granola API ----------------------------------------------------------
# Requires a Granola Business/Enterprise plan. Create a key in Granola
# Settings → API. Keys look like grn_xxx.
GRANOLA_API_KEY=""
# Base URL — only change if Granola tells you to.
GRANOLA_API_BASE="https://public-api.granola.ai/v1"
# When a Granola note has attendees who aren't in your CRM yet, create a
# contact for them automatically. Set to "false" to disable.
GRANOLA_AUTO_CREATE_CONTACTS="true"
# Max new notes to process per sync run. Each new note needs a detail fetch
# (and, if AI extraction is on, an LLM call), so this keeps a run bounded.
# Already-imported notes are skipped, so running sync again backfills older
# history a chunk at a time.
MAX_NOTES_PER_SYNC="25"
# Your own email(s), comma-separated. Attendees matching these are skipped so
# the sync never creates a contact (or logs an interaction) for yourself.
OWNER_EMAIL=""

# --- AI follow-up extraction (optional) -----------------------------------
# After each Granola sync, an LLM reads each new note's summary and surfaces
# people you should follow up with (mentioned, not just attendees) as review
# suggestions on the dashboard. Requires an Anthropic API key.
# Leave ANTHROPIC_API_KEY blank to disable extraction.
ANTHROPIC_API_KEY=""
# Model for extraction. Haiku is cheap and plenty for this; bump to
# claude-opus-4-8 if you want deeper reasoning.
EXTRACT_MODEL="claude-haiku-4-5"

# --- Slack digest ---------------------------------------------------------
# Incoming webhook URL. Leave blank to disable the digest.
SLACK_WEBHOOK_URL=""

# --- Scheduling -----------------------------------------------------------
# Cron expressions (server timezone below). Defaults: sync every 2 hours,
# weekly digest Monday 08:00, daily nudge every day at 08:00.
GRANOLA_SYNC_CRON="0 */2 * * *"
DIGEST_CRON="0 8 * * 1"
DAILY_NUDGE_CRON="0 8 * * *"
# IANA timezone for the cron schedules and date math.
TZ="America/New_York"
# Set to "false" to turn off the in-process scheduler (e.g. if you drive
# sync/digest from an external Railway Cron service instead).
ENABLE_SCHEDULER="true"

# --- Automation auth ------------------------------------------------------
# Bearer token that lets external cron / Zapier call the sync & digest
# endpoints without a login cookie. Generate like APP_SECRET above.
CRON_SECRET="change-me-random"

# --- Behavior tuning ------------------------------------------------------
# A contact with no interaction in this many days is flagged as "going cold".
COLD_AFTER_DAYS="21"
