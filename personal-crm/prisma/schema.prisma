// Personal Networking CRM data model.
// Provider is SQLite by default (simplest to host on Railway with a volume).
// To use Postgres instead: change provider to "postgresql", set DATABASE_URL
// to your Postgres connection string, then run `prisma db push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A person you're networking with.
model Contact {
  id             String    @id @default(cuid())
  name           String
  email          String?
  company        String?
  role           String?
  linkedinUrl    String?
  howMet         String?
  /// Free-form comma-separated tags/topics, e.g. "biosecurity, funder, warm intro".
  tags           String?
  /// One of the values in lib/status.ts: reached_out | connected | pending_reply | replied | cold
  status         String    @default("reached_out")
  notes          String?
  /// Colleagues at your own org — kept for history but excluded from all
  /// networking views, digests, and nudges.
  isCoworker     Boolean   @default(false)
  /// Archived contacts (one-off sales demos etc.) are hidden everywhere
  /// except the Archived tab; sync still matches them so they don't come back.
  archivedAt     DateTime?
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  interactions Interaction[]

  @@index([status])
  @@index([nextFollowUpAt])
  @@index([archivedAt])
}

/// A single touchpoint with a contact (message, call, meeting, Granola note...).
model Interaction {
  id            String   @id @default(cuid())
  contactId     String
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  occurredAt    DateTime @default(now())
  /// linkedin | email | call | meeting | note | granola
  channel       String   @default("note")
  summary       String?
  /// Granola note id, used to dedupe on sync (one entry per contact per note).
  granolaNoteId String?
  granolaUrl    String?
  createdAt     DateTime @default(now())

  @@unique([contactId, granolaNoteId])
  @@index([contactId])
  @@index([occurredAt])
}

/// A person the AI extracted from a Granola note that you should follow up
/// with (an action item / mention), pending your review on the dashboard.
model Suggestion {
  id              String   @id @default(cuid())
  name            String
  /// Why to reach out / what the note said about them.
  reason          String?
  /// Verbatim quote from the note where they were mentioned.
  context         String?
  /// Set when the name confidently matches ONE existing contact (exact full
  /// name or a saved alias) — accepting queues that contact, no duplicate.
  contactId       String?
  /// JSON array of candidate contact ids when the match is ambiguous
  /// (first-name-only or fuzzy). You pick; your pick is remembered as an alias.
  candidates      String?
  sourceNoteId    String?
  sourceNoteTitle String?
  sourceUrl       String?
  /// pending | accepted | dismissed
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  @@unique([sourceNoteId, name])
  @@index([status])
}

/// A learned name → contact mapping ("lesley" = Lesley Smith). Created when
/// you resolve an ambiguous suggestion or merge duplicates; future mentions of
/// the alias auto-resolve (coworkers get skipped silently).
model ContactAlias {
  alias     String   @id
  contactId String
  createdAt DateTime @default(now())

  @@index([contactId])
}

/// Marks a Granola note as already imported. `extractedAt` tracks the AI
/// extraction separately, so notes synced before ANTHROPIC_API_KEY was set
/// get extracted on a later sync (backfill) instead of being skipped forever.
model ProcessedNote {
  noteId      String    @id
  extractedAt DateTime?
  createdAt   DateTime  @default(now())
}

/// Bookkeeping for the Granola sync job (single row, id = "granola").
model SyncState {
  id         String    @id
  lastSyncAt DateTime?
  cursor     String?
  lastError  String?
  updatedAt  DateTime  @updatedAt
}
