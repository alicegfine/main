# Copy to .env for local development. On Railway, set these as service variables.

# Password for signing in as Alice to edit the schedule and the "How it works" page.
# Required — without it, sign-in is disabled and the site stays read-only.
ADMIN_PASSWORD=change-me

# Signs the session cookie. Use a long random string, e.g.
#   openssl rand -hex 32
# If unset, one is generated and stored in the database, so sign-ins survive
# restarts for as long as the database itself does.
SESSION_SECRET=

# Where the SQLite database lives — the schedule, the signups and the spiel.
#
# On Railway this MUST be your volume's mount path, written as an ABSOLUTE path:
#   DATA_DIR=/data
# A relative value like ./data resolves against the app directory instead of the
# volume, so the volume sits unused and every deploy and restart wipes the data.
# The relative default below is only appropriate for running locally.
DATA_DIR=./data
