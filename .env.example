# Copy to .env for local development. On Railway, set these as service variables.

# Password for signing in as Alice to edit the schedule and the "How it works" page.
# Required — without it, sign-in is disabled and the site stays read-only.
ADMIN_PASSWORD=change-me

# Signs the session cookie. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random one is generated at startup, which means everyone is
# signed out whenever the server restarts.
SESSION_SECRET=

# Where the SQLite database lives. On Railway, attach a volume and set this to
# the mount path so signups survive redeploys.
DATA_DIR=./data
