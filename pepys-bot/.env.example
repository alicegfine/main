# Copy this file to .env and fill in real values, then `source .env` before
# running the bot. The cron entry in the README sets these inline instead.

# The bot's own Signal-registered phone number, in E.164 format.
SIGNAL_SENDER=+15551234567

# The Signal group ID, copied from `curl http://localhost:8080/v1/groups/$SIGNAL_SENDER`.
SIGNAL_GROUP_ID=

# Where signal-cli-rest-api is listening. Default works if it's on the same host.
SIGNAL_API_URL=http://localhost:8080
