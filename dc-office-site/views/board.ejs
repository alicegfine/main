<%- include('partials/head', { pageTitle: "Who's in", navActive: 'board', user, officeName }) %>

<div class="page-head">
  <div>
    <h1>Who&rsquo;s in the office</h1>
    <p class="sub">Click a day to mark yourself in or out. Everyone sees the change immediately.</p>
  </div>
  <a class="btn-subscribe" href="<%= subscribeUrl %>" target="_blank" rel="noopener">
    Subscribe in Google Calendar
  </a>
</div>

<div class="callout">
  <strong>Subscribe once and you&rsquo;re done.</strong>
  The button above adds the shared <em><%= board.officeName %></em> calendar to your Google Calendar.
  It stays in sync on its own &mdash; no downloads, no re-importing.
</div>

<div id="status" class="status" role="status" aria-live="polite" hidden></div>

<div id="board" data-today="<%= board.today %>">
  <% board.weeks.forEach(function (week) { %>
    <section class="week">
      <div class="week-head">
        <h2><%= week.label %></h2>
        <span class="week-range"><%= week.range %></span>
      </div>

      <div class="days">
        <% week.days.forEach(function (day) { %>
          <article class="day <%= day.isToday ? 'is-today' : '' %> <%= day.isPast ? 'is-past' : '' %>"
                   data-day="<%= day.key %>">
            <header class="day-head">
              <span class="day-weekday"><%= day.weekdayShort %></span>
              <span class="day-date"><%= day.month %> <%= day.dayOfMonth %></span>
              <% if (day.isToday) { %><span class="today-tag">Today</span><% } %>
            </header>

            <p class="day-count" data-count><%= day.count %> <%= day.count === 1 ? 'person' : 'people' %></p>

            <ul class="roster" data-roster>
              <% day.people.forEach(function (person) { %>
                <li class="<%= person.isMe ? 'me' : '' %>" title="<%= person.email %>"><%= person.name %></li>
              <% }) %>
            </ul>

            <% if (day.editable) { %>
              <button class="toggle <%= day.meIn ? 'in' : '' %>"
                      data-toggle
                      aria-pressed="<%= day.meIn %>">
                <%= day.meIn ? "You're in" : "I'll be in" %>
              </button>
            <% } else { %>
              <p class="locked">Past</p>
            <% } %>
          </article>
        <% }) %>
      </div>
    </section>
  <% }) %>
</div>

<script src="/static/app.js" defer></script>

<%- include('partials/foot', { officeName }) %>
