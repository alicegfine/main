<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> · <%= officeName %></title>
  <link rel="stylesheet" href="/static/styles.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>&#127970;</text></svg>">
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">BB</span>
        <span><%= officeName %></span>
      </a>
      <% if (user) { %>
        <nav class="nav">
          <a href="/" class="<%= navActive === 'board' ? 'active' : '' %>">Who&rsquo;s in</a>
          <a href="/faq" class="<%= navActive === 'faq' ? 'active' : '' %>">FAQ</a>
        </nav>
        <form class="signout" method="post" action="/logout">
          <span class="who" title="<%= user.email %>"><%= user.name %></span>
          <button type="submit">Sign out</button>
        </form>
      <% } %>
    </div>
  </header>

  <main class="wrap">
