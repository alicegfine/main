<%- include('partials/head', { pageTitle: 'Sign in', navActive: '', user: null, officeName }) %>

<div class="login">
  <span class="brand-mark large" aria-hidden="true">BB</span>
  <h1><%= officeName %></h1>
  <p class="sub">Sign in with your Blueprint Biosecurity account to see who&rsquo;s in and mark your own days.</p>

  <% if (error) { %>
    <div class="callout warn"><%= error %></div>
  <% } %>

  <a class="btn-google" href="/auth/google?returnTo=<%= encodeURIComponent(returnTo) %>">
    Sign in with Google
  </a>

  <p class="fine">Limited to <%= allowedDomain %> accounts.</p>
</div>

<%- include('partials/foot', { officeName }) %>
