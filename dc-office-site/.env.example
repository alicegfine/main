# Copy to .env for local development. In production set these as Railway
# service variables — never commit real values.

# Public URL of the deployed site, no trailing slash. Must exactly match the
# origin Google redirects back to.
BASE_URL=http://localhost:3000

# Random string used to sign the session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google Workspace domain allowed to sign in.
ALLOWED_DOMAIN=blueprintbiosecurity.org

# Railway injects this automatically once a Postgres database is attached.
DATABASE_URL=postgres://localhost:5432/dc_office

# OAuth client (Web application) from Google Cloud console.
# Authorized redirect URI must be: <BASE_URL>/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# The entire service account JSON key file, as one line.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Calendar ID of the shared "DC Office" calendar. Google Calendar →
# the calendar's Settings → "Integrate calendar" → Calendar ID.
OFFICE_CALENDAR_ID=

# Optional.
OFFICE_TIMEZONE=America/New_York
OFFICE_NAME=DC Office
WEEKS_SHOWN=2
NODE_ENV=development
